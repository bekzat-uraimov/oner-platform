# Copy to .env and fill real values. .env is gitignored — never commit secrets.

# App
APP_NAME="ONER API"
# Anything but development refuses to start without a real JWT_SECRET.
ENVIRONMENT=development
DEBUG=true
# Browser origins allowed to call the API, as a JSON list. Empty allows none.
CORS_ORIGINS=["http://localhost:3000"]
# Header holding the real client IP, set by a platform that overwrites what the
# client sent. On Vercel: x-vercel-forwarded-for. Leave empty elsewhere.
TRUSTED_IP_HEADER=
# Behind a proxy (Railway, DO). Read by uvicorn, not the app. Without it every
# request looks like it came from the proxy, and each rate limit becomes one
# bucket shared by all users. Set it to the proxy's address range.
# FORWARDED_ALLOW_IPS=

# Database (docker-compose default)
DATABASE_URL=postgresql+psycopg://oner:oner@localhost:5432/oner

# Auth — generate a strong secret, e.g. `openssl rand -hex 32` (32+ characters)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Payments — FreedomPay (sandbox). Ask the merchant manager for test creds.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_INIT_URL=https://api.freedompay.kg/init_payment.php
FREEDOMPAY_RESULT_URL=http://localhost:8000/webhooks/freedompay/result
# Frontend pages the buyer's browser lands on after paying. Not API routes.
FREEDOMPAY_SUCCESS_URL=http://localhost:3000/checkout/success
FREEDOMPAY_FAILURE_URL=http://localhost:3000/checkout/failure
# 1 = sandbox, 0 = live money
FREEDOMPAY_TESTING_MODE=1

# Video — Kinescope. We mint the drmauthtoken; Kinescope calls /drm/auth on play.
KINESCOPE_PROJECT_ID=
KINESCOPE_API_KEY=
# Optional Basic Auth on /drm/auth. Kinescope has no request signature, so this
# is the only transport check available — the signed token is the real gate.
KINESCOPE_DRM_AUTH_USER=
KINESCOPE_DRM_AUTH_PASSWORD=
DRM_TOKEN_TTL_MIN=10
# Admin video uploads land in this folder when set, otherwise the project root.
KINESCOPE_FOLDER_ID=
# Basic Auth for Kinescope's status webhook; register the same pair with
# Kinescope. The webhook stays closed until these are set.
KINESCOPE_WEBHOOK_USER=
KINESCOPE_WEBHOOK_PASSWORD=

# Materials — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Seconds a download link stays valid. Short on purpose — links get forwarded.
MATERIAL_URL_TTL_S=60
# Seconds an admin upload link stays valid. Longer: a big file has to finish
# uploading inside the window.
MATERIAL_UPLOAD_TTL_S=900
# Hours an R2 file with no material row survives before the sweep deletes it.
MATERIAL_ORPHAN_GRACE_H=24
